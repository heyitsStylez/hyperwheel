{
  "buildCommand": "git fetch --tags --depth=1 origin || true; python3 build.py --check",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "framework": null,
  "redirects": [
    {
      "source": "/wheeler/:path*",
      "has": [{ "type": "host", "value": "hyperwheel.vercel.app" }],
      "destination": "https://gowheeler.vercel.app/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
